# ==============================================================================
# 1. TypeSafe Jev (System One 决策模型)
# ==============================================================================
TYPESAFE_API_KEY=your_typesafe_jev_api_key_here
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# ==============================================================================
# 2. 主生成层 DeepSeek-V4.1-Flash (走 /v1/responses 协议)
# ==============================================================================
LLM_PROTOCOL=responses
LLM_PRIMARY_BASE_URL=https://go.penguin.ooo/api/v1
LLM_PRIMARY_RESPONSES_URL=https://go.penguin.ooo/api/v1/responses
LLM_PRIMARY_API_KEY=your_penguin_api_key_here
LLM_PRIMARY_MODEL=deepseek-flash
EFFECTIVE_CONTEXT_WINDOW=272000

# 备用节点槽位 (预留给后续 vLLM 引入，架构与三态熔断不变)
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_BASE_URL=http://127.0.0.1:8000/v1
LLM_FALLBACK_API_KEY=EMPTY
LLM_FALLBACK_MODEL=vllm/deepseek-ai/DeepSeek-V4-Flash

# ==============================================================================
# 3. 多模态向量 Embedding: Google Vertex AI gemini-embedding-2 (1024 维)
# ==============================================================================
EMBEDDING_PROVIDER=gemini_vertex_v1beta
EMBEDDING_URL=https://go.penguin.ooo/api/v1beta/models/gemini-embedding-2:batchEmbedContents
EMBEDDING_API_KEY=your_penguin_api_key_here
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=1024

# ==============================================================================
# 4. 腾讯云 COS 对象存储
# ==============================================================================
COS_HOST=https://your-bucket.cos.ap-guangzhou.myqcloud.com
COS_REGION=ap-guangzhou
COS_BUCKET=your-bucket-name
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key

# ==============================================================================
# 5. PostgreSQL + pgvector 数据库配置
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=shopping_agent
POSTGRES_HOST=192.168.100.128
POSTGRES_PORT=5432
