{
  "$comment": "spec_key 的权威定义：单位、默认比较方向、取值范围、离散整数标记、枚举词表、商品事实展示标签(display_label/display_labels)与中文查询触发同义词(zh_aliases)。注意：zh_aliases 仅用于用户 Query 侧匹配，严禁反向拼入商品 retrieval_text 充当商品事实。",
  "version": "2026-10-11.r2",
  "rules": {
    "numeric_specs": "值必须是有限 JSON number（禁止 bool/NaN/Inf），不带单位、不带 '+'、不带任何单位字母。声明 integer=true 的离散维度必须为严格整数(int)。展示用字符串只进 title / highlights。",
    "enum_specs": "值必须取自本文件 vocabulary 声明的封闭词表（小写 snake_case）。商品事实展示只使用 display_labels 中的中性标签；用户 Query 通过 zh_aliases 与 matching_policy 映射到枚举值或候选集。型号名（如 GaN-65W-Pro、TTC金粉轴V2）不进枚举，进 title。",
    "fact_vs_query_alias_isolation": "构建 retrieval_text 时，只允许使用 sub_category.display_label 与 enum_spec.display_labels[val] 以及 SKU 自身真实属性，严禁把 zh_aliases 列表拼接进商品检索语料（防止将圆领卫衣注入连帽卫衣、金粉轴注入红轴）。",
    "price_judgement": "预算约束只对 final_price 判定；original_price 仅用于 price_explain_card 的直降差额解释及历史订单价保测试。",
    "relaxation_path_a": "保规格、松预算：对用户提取出的全部规格条件 AND 过滤，在命中集合内取 min(final_price)。",
    "relaxation_path_b": "保预算、松规格（数值型基准）：只锁 sub_category + final_price <= max_price，不拿任何单个规格阈值过滤；在预算内同子类目商品上基于数值 spec range 计算多规格归一化接近度得分 Closeness(s) = 1 - mean(deficit_i / span_i)，取第 1 名。",
    "category_lock": "单品类检索与松弛强制锁死在同一 sub_category 内执行，防止跨子类目串品。"
  },
  "matching_policy": {
    "normalization": [
      "unicode_nfkc",
      "ascii_lower",
      "fullwidth_to_halfwidth",
      "strip_whitespace_around_operators"
    ],
    "span_resolution": "longest_match_first",
    "span_resolution_doc": "在同一文本区间内若命中多个候选 alias（如 'PA++++' 同时包含 'PA+'/'PA++'/'PA+++'，或 '有声段落轴' 包含 '段落轴'，或 '混油皮' 包含 '油皮'），按规范化后字符长度降序优先匹配最长 alias，并消费该字符区间，禁止子区间重复触发短 alias。",
    "boundary_rules": {
      "pa_plus_guard": "匹配 PA+ / PA++ / PA+++ 时，右侧相邻字符不得为 '+'（正则：(?<!\\+)(pa\\+{1,4})(?!\\+)）。",
      "numeric_token_guard": "含数字的 alias（如 87键、98键、104键、5Gbps、10Gbps、40Gbps）左侧相邻字符不得为阿拉伯数字。"
    },
    "negation_prefixes": ["不要", "不需要", "并非", "不是", "不选", "排除", "不买", "别推", "拒绝", "不考虑"],
    "negation_window_chars": 4,
    "multi_sub_category_policy": "当同一条 Query 在不重叠区间命中多个不同 sub_category（如 '买面霜和防晒' 命中 facial_cream + sunscreen，或复合词 '连帽卫衣开衫' 同时涉及 hoodie + knit_cardigan），优先检查是否存在更长的专有复合词规则；若确属多品类意图，返回 matched_sub_categories 列表并标记 ambiguity_status='multi_sub_category'，禁止盲目只取第一个词锁死单子类目。"
  },
  "ambiguous_terms": {
    "108键": {
      "scope": "mechanical_keyboard.layout",
      "action": "soft_or_clarify",
      "candidates": ["104_keys"],
      "reason": "108键比104键多4颗右上角多媒体键，物理键数不等价，不得硬映射为 104_keys 硬过滤条件；可作为全尺寸偏好提示或引导选择 104_keys。"
    },
    "全尺寸": {
      "scope": "mechanical_keyboard.layout",
      "action": "candidate_set",
      "candidates": ["104_keys", "98_keys"],
      "reason": "全尺寸通常指代 104_keys，但部分用户包含紧凑全尺寸 98_keys，作为候选集而非唯一硬过滤。"
    },
    "全肤质": {
      "scope": "facial_cream.skin_type",
      "action": "no_hard_filter",
      "candidates": ["dry_sensitive", "oily_acne", "combination", "neutral"],
      "reason": "全肤质代表不限制适用肤质，不应硬映射为单一 neutral（中性肌）而过滤掉其余肤质商品。"
    },
    "普通肤质": {
      "scope": "facial_cream.skin_type",
      "action": "soft_or_clarify",
      "candidates": ["neutral", "combination"],
      "reason": "普通肤质口语指代模糊，不直接等价于严格中性皮。"
    },
    "敏感肌": {
      "scope": "facial_cream.skin_type",
      "action": "soft_preference",
      "candidates": ["dry_sensitive"],
      "soft_keyword": "敏感肌",
      "reason": "敏感肌包含干敏与油敏，不能无条件推出干性(dry_sensitive)；应作为软约束关键词参与检索加权，仅当明确说'干敏皮/干敏肌'时才触发 dry_sensitive 硬枚举。"
    },
    "USB3.2": {
      "scope": "usb_hub_cable.protocol",
      "action": "candidate_set",
      "candidates": ["usb3.0", "usb3.2gen2"],
      "reason": "USB-IF 命名中 USB3.2 Gen1(5Gbps) 与 USB3.2 Gen2(10Gbps) 均含 USB3.2 前缀，未写明 Gen2 或 10Gbps 时不得直接硬映射为 usb3.2gen2。"
    },
    "连帽卫衣开衫": {
      "scope": "sub_category",
      "action": "compound_sub_category",
      "primary_sub_category": "hoodie",
      "candidates": ["hoodie", "knit_cardigan"],
      "reason": "拉链连帽卫衣开衫在服饰类目归属卫衣(hoodie)，不归入毛衣针织开衫(knit_cardigan)。"
    }
  },
